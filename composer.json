{
    "name": "dmlab/module-typesense-core",
    "description": "Typesense access layer for Magento 2: HTTP client, collection lifecycle, aliases, document writes, synonym sets, schema reconciler, diagnostic CLI. No catalog or search-subsystem knowledge.",
    "keywords": [
        "magento2",
        "magento2-module",
        "magento 2",
        "typesense",
        "typesense client",
        "search engine",
        "elasticsearch alternative",
        "opensearch replacement",
        "zero-downtime reindex",
        "failover"
    ],
    "homepage": "https://github.com/dmlab-work/module-typesense-core",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "support": {
        "issues": "https://github.com/dmlab-work/module-typesense-core/issues",
        "source": "https://github.com/dmlab-work/module-typesense-core"
    },
    "version": "0.2.1",
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "ext-curl": "*",
        "magento/framework": "^103.0.7",
        "laminas/laminas-http": "^2.15",
        "symfony/console": "^6.4||^7.4",
        "psr/log": "^2.0||^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5||^12.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DmLab\\TypesenseCore\\": ""
        }
    }
}
